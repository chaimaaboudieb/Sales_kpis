<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Liste des commerciaux -->
    <record id="view_sales_commercial_list" model="ir.ui.view">
        <field name="name">sales.commercial.list</field>
        <field name="model">sales.commercial</field>
        <field name="arch" type="xml">
            <list string="Commerciaux">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>


    <!-- Formulaire d'un commercial -->
    <record id="view_sales_commercial_form" model="ir.ui.view">
        <field name="name">sales.commercial.form</field>
        <field name="model">sales.commercial</field>
        <field name="arch" type="xml">
            <form string="Commercial">

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Recherche des commerciaux -->
    <record id="view_sales_commercial_search" model="ir.ui.view">
        <field name="name">sales.commercial.search</field>
        <field name="model">sales.commercial</field>
        <field name="arch" type="xml">
            <search string="Rechercher un commercial">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="action_sales_commercial" model="ir.actions.act_window">
        <field name="name">Commerciaux</field>
        <field name="res_model">sales.commercial</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>